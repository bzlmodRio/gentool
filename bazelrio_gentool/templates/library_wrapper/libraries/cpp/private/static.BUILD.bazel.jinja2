load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "static_libs",
    srcs = glob(
        [
            "**/*.lib",
            "**/*.a",
        ],
        allow_empty = True,
    ),
    visibility = {{ visibility }},
    deps = [
      {%- for dep in target.get_sorted_dependencies() %}
        "@{{dep.repo_name}}//libraries/cpp/{{dep.parent_folder}}:static",
      {%- endfor %}
    ],
)

