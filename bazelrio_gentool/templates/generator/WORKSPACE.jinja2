workspace(name = "{{group.repo_name}}-gentool")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Python, for gentool
{{ bazel_dependencies.rules_python.download_repository(0, maybe=False) }}

load("@rules_python//python:repositories.bzl", "py_repositories")

py_repositories()

local_repository(
    name = "bzlmodrio-gentool",
    path = "../../../gentool",
)

{% for dep in dependencies %}
local_repository(
    name = "{{dep}}-gentool",
{%- if "opencv" in dep or "-ni" in dep %}
    path = "../../../wpilibsuite_gen/libraries/{{dep.replace("bzlmodrio", "bzlmodRio")}}/generate",
{%- else %}
    path = "../../{{dep.replace("bzlmodrio", "bzlmodRio")}}/generate",
{%- endif %}
)
{% endfor %}

load("@rules_python//python:repositories.bzl", "python_register_toolchains")

python_register_toolchains(
    name = "python_3_10",
    ignore_root_user_error = True,
    python_version = "3.10",
)

load("@rules_python//python:pip.bzl", "pip_parse")

pip_parse(
    name = "bzlmodrio-gentool-pip",
    python_interpreter_target = "@python_3_10_host//:python",
    requirements_lock = "@bzlmodrio-gentool//:requirements_lock.txt",
)


load("@bzlmodrio-gentool-pip//:requirements.bzl", "install_deps")

install_deps()
